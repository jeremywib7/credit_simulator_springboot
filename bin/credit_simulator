#!/usr/bin/env sh
# Launcher: (re)builds the jar when missing or older than the sources, then starts the app.
set -eu

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
JAR="$ROOT/target/credit_simulator.jar"

needs_build() {
    [ ! -f "$JAR" ] && return 0
    [ -n "$(find "$ROOT/src" "$ROOT/pom.xml" -newer "$JAR" -type f 2>/dev/null | head -n 1)" ]
}

command -v java >/dev/null 2>&1 || { echo "Error: Java 17+ is required." >&2; exit 127; }

if needs_build; then
    echo "Building credit_simulator..." >&2
    (cd "$ROOT" && ./mvnw -B -q -DskipTests package) >&2
fi

exec java -jar "$JAR" "$@"
